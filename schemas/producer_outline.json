{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "producer_outline.schema.json",
  "title": "ProducerOutline",
  "description": "Agent A's (Producer/Writer) structural plan for the episode, produced from episode_brief.json.",
  "type": "object",
  "required": ["episode_id", "status", "thesis", "beats"],
  "additionalProperties": false,
  "properties": {
    "episode_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "drafted", "approved"],
      "default": "pending"
    },
    "thesis": {
      "type": "string",
      "description": "The one-sentence argument/story the episode is built around"
    },
    "hook": {
      "type": "string",
      "description": "The cold-open line(s) meant to grab attention before the thesis unfolds"
    },
    "estimated_runtime_sec": {
      "type": "integer",
      "minimum": 0
    },
    "key_factual_claims": {
      "type": "array",
      "description": "Factual claims the episode relies on, each traceable to a source, so later stages can verify or cite them",
      "items": {
        "type": "object",
        "required": ["claim_id", "claim", "source_url"],
        "additionalProperties": false,
        "properties": {
          "claim_id": { "type": "string" },
          "claim": { "type": "string" },
          "relevant_beats": {
            "type": "array",
            "items": { "type": "string" },
            "description": "beat_id values this claim supports"
          },
          "source_url": { "type": "string" },
          "note": {
            "type": "string",
            "description": "Caveats about source reliability, e.g. an unconfirmed secondary citation"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "description": "Unresolved research questions Agent B or later research should try to answer",
      "items": { "type": "string" }
    },
    "beats": {
      "type": "array",
      "description": "Ordered narrative beats making up the episode",
      "items": {
        "type": "object",
        "required": ["beat_id", "summary"],
        "additionalProperties": false,
        "properties": {
          "beat_id": { "type": "string" },
          "summary": { "type": "string" },
          "narration_notes": { "type": "string" },
          "visual_notes": { "type": "string" }
        }
      }
    }
  }
}
